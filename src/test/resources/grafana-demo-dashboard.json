{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" },
    { "name": "DS_INFLUXDB",   "label": "InfluxDB",   "type": "datasource", "pluginId": "influxdb",   "pluginName": "InfluxDB" },
    { "name": "DS_MYSQL",      "label": "MySQL",      "type": "datasource", "pluginId": "mysql",      "pluginName": "MySQL" }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",     "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus",  "version": "1.0.0" },
    { "type": "datasource", "id": "influxdb",   "name": "InfluxDB",    "version": "1.0.0" },
    { "type": "datasource", "id": "mysql",      "name": "MySQL",       "version": "5.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat",       "name": "Stat",        "version": "" },
    { "type": "panel", "id": "gauge",      "name": "Gauge",       "version": "" },
    { "type": "panel", "id": "piechart",   "name": "Pie chart",   "version": "" },
    { "type": "panel", "id": "bargauge",   "name": "Bar gauge",   "version": "" },
    { "type": "panel", "id": "barchart",   "name": "Bar chart",   "version": "" }
  ],
  "dashboard": {
    "id": null,
    "uid": "demo-monitoring",
    "title": "Demo Monitoring Dashboard – server-node01",
    "description": "Vollständiges Demo-Dashboard mit Prometheus-, InfluxDB- und MySQL-Datenquellen sowie Alerting-Regeln.",
    "tags": ["demo", "monitoring", "influxdb", "mysql", "alerting"],
    "timezone": "browser",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "1h"] },
    "schemaVersion": 36,
    "version": 1,

    "templating": {
      "list": [
        {
          "name": "interval", "label": "Interval", "type": "interval",
          "options": [
            { "selected": false, "text": "1m",  "value": "1m" },
            { "selected": true,  "text": "5m",  "value": "5m" },
            { "selected": false, "text": "15m", "value": "15m" },
            { "selected": false, "text": "1h",  "value": "1h" }
          ],
          "current": { "text": "5m", "value": "5m" }, "hide": 0, "auto": false
        },
        {
          "name": "server", "label": "Server", "type": "query",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "query": "label_values(up, instance)",
          "current": { "text": "node01:9100", "value": "node01:9100" },
          "refresh": 2, "multi": false, "includeAll": false, "hide": 0
        },
        {
          "name": "db_host", "label": "DB Host", "type": "query",
          "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "query": "SELECT DISTINCT host FROM information_schema.processlist",
          "current": { "text": "db-primary", "value": "db-primary" },
          "refresh": 2, "multi": false, "includeAll": false, "hide": 0
        }
      ]
    },

    "annotations": {
      "list": [
        {
          "name": "Deployments", "type": "dashboard", "enable": true,
          "iconColor": "rgba(0,211,255,1)", "hide": false,
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "changes(demo_build_info[2m]) > 0",
          "titleFormat": "Deployment",
          "textFormat": "Version: {{version}}",
          "tags": ["deployment"]
        },
        {
          "name": "Alerts", "type": "alert", "enable": true,
          "iconColor": "rgba(255,96,96,1)", "hide": false
        }
      ]
    },

    "panels": [

      { "id": 0, "type": "row", "title": "Zeitreihen – Prometheus", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

      {
        "id": 1, "type": "timeseries", "title": "CPU-Auslastung",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 90, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by(instance) (rate(node_cpu_seconds_total{mode!=\"idle\",instance=~\"$server\"}[$interval]))",
          "legendFormat": "CPU % – {{instance}}" }],
        "alert": {
          "name": "Hohe CPU-Auslastung",
          "message": "CPU-Nutzung auf $server liegt über 90 % für mehr als 5 Minuten.",
          "noDataState": "NoData", "executionErrorState": "Alerting", "frequency": "1m", "for": "5m", "handler": 1,
          "conditions": [{ "evaluator": { "params": [90], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["A", "5m", "now"] }, "reducer": { "params": [], "type": "avg" }, "type": "query" }],
          "notifications": [{ "uid": "alert-channel-ops" }]
        }
      },

      {
        "id": 2, "type": "timeseries", "title": "Arbeitsspeicher",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 75, "color": "yellow" }, { "value": 90, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$server\"} / node_memory_MemTotal_bytes{instance=~\"$server\"})) * 100",
          "legendFormat": "RAM % – {{instance}}" }],
        "alert": {
          "name": "Hohe Speicherauslastung",
          "message": "RAM-Nutzung auf $server liegt über 85 % für mehr als 10 Minuten.",
          "noDataState": "NoData", "executionErrorState": "Alerting", "frequency": "1m", "for": "10m", "handler": 1,
          "conditions": [{ "evaluator": { "params": [85], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["A", "10m", "now"] }, "reducer": { "params": [], "type": "avg" }, "type": "query" }],
          "notifications": [{ "uid": "alert-channel-ops" }]
        }
      },

      {
        "id": 3, "type": "timeseries", "title": "Festplatten-I/O",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 0, "y": 9, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "Bps" } },
        "targets": [
          { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(node_disk_read_bytes_total{instance=~\"$server\",device!~\"loop.*\"}[$interval])", "legendFormat": "Lesen – {{device}}" },
          { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(node_disk_written_bytes_total{instance=~\"$server\",device!~\"loop.*\"}[$interval])", "legendFormat": "Schreiben – {{device}}" }
        ]
      },

      {
        "id": 4, "type": "timeseries", "title": "Netzwerk-I/O (eth0)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 12, "y": 9, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "Bps", "color": { "mode": "palette-classic" } } },
        "targets": [
          { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(node_network_receive_bytes_total{instance=~\"$server\",device=\"eth0\"}[$interval])", "legendFormat": "Eingehend B/s" },
          { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(node_network_transmit_bytes_total{instance=~\"$server\",device=\"eth0\"}[$interval])", "legendFormat": "Ausgehend B/s" }
        ]
      },

      { "id": 9, "type": "row", "title": "Status – Prometheus", "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 } },

      {
        "id": 5, "type": "stat", "title": "Festplattennutzung",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 0, "y": 18, "w": 6, "h": 4 },
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 85, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - node_filesystem_avail_bytes{instance=~\"$server\",mountpoint=\"/\"} / node_filesystem_size_bytes{instance=~\"$server\",mountpoint=\"/\"}) * 100",
          "legendFormat": "% belegt" }]
      },

      {
        "id": 6, "type": "stat", "title": "System Load (1m)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 6, "y": 18, "w": 6, "h": 4 },
        "fieldConfig": { "defaults": { "min": 0, "max": 8, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 2, "color": "yellow" }, { "value": 5, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_load1{instance=~\"$server\"}", "legendFormat": "Load Average" }]
      },

      {
        "id": 7, "type": "stat", "title": "TCP-Verbindungen",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 12, "y": 18, "w": 6, "h": 4 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } } },
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_sockstat_TCP_inuse{instance=~\"$server\"}", "legendFormat": "aktiv" }]
      },

      {
        "id": 8, "type": "stat", "title": "CPU-Temperatur",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 18, "y": 18, "w": 6, "h": 4 },
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "celsius",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 65, "color": "yellow" }, { "value": 80, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_hwmon_temp_celsius{instance=~\"$server\",sensor=\"temp1\"}", "legendFormat": "°C" }]
      },

      { "id": 10, "type": "row", "title": "Gauge & Verteilung – Prometheus", "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 } },

      {
        "id": 11, "type": "gauge", "title": "CPU-Last (Gauge)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 0, "y": 23, "w": 8, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 90, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "avg by(instance) (rate(node_cpu_seconds_total{mode!=\"idle\",instance=~\"$server\"}[$interval]))", "legendFormat": "CPU %" }]
      },

      {
        "id": 12, "type": "gauge", "title": "RAM-Auslastung (Gauge)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 8, "y": 23, "w": 8, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 75, "color": "semi-dark-yellow" }, { "value": 90, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(1 - node_memory_MemAvailable_bytes{instance=~\"$server\"} / node_memory_MemTotal_bytes{instance=~\"$server\"}) * 100", "legendFormat": "RAM %" }]
      },

      {
        "id": 13, "type": "piechart", "title": "Anfragen nach HTTP-Status",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 16, "y": 23, "w": 8, "h": 8 },
        "fieldConfig": { "defaults": {} },
        "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right" } },
        "targets": [
          { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "sum(rate(http_requests_total{instance=~\"$server\",status=~\"2..\"}[$interval]))", "legendFormat": "2xx OK" },
          { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "sum(rate(http_requests_total{instance=~\"$server\",status=~\"4..\"}[$interval]))", "legendFormat": "4xx Client-Fehler" },
          { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "sum(rate(http_requests_total{instance=~\"$server\",status=~\"5..\"}[$interval]))", "legendFormat": "5xx Server-Fehler" }
        ]
      },

      { "id": 14, "type": "row", "title": "Balkendiagramme – Prometheus", "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 } },

      {
        "id": 15, "type": "bargauge", "title": "HTTP-Anfragen / Service",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "req/s" } },
        "targets": [
          { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(http_requests_total{service=\"api\",instance=~\"$server\"}[$interval])", "legendFormat": "api" },
          { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(http_requests_total{service=\"auth\",instance=~\"$server\"}[$interval])", "legendFormat": "auth" },
          { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(http_requests_total{service=\"web\",instance=~\"$server\"}[$interval])", "legendFormat": "web" },
          { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "rate(http_requests_total{service=\"worker\",instance=~\"$server\"}[$interval])", "legendFormat": "worker" }
        ]
      },

      {
        "id": 16, "type": "barchart", "title": "Latenz P95 / Endpunkt (ms)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "ms" } },
        "targets": [
          { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{endpoint=\"/api/search\",instance=~\"$server\"}[$interval])) * 1000", "legendFormat": "/api/search" },
          { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{endpoint=\"/api/analyse\",instance=~\"$server\"}[$interval])) * 1000", "legendFormat": "/api/analyse" },
          { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{endpoint=\"/health\",instance=~\"$server\"}[$interval])) * 1000", "legendFormat": "/health" },
          { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{endpoint=\"/metrics\",instance=~\"$server\"}[$interval])) * 1000", "legendFormat": "/metrics" }
        ]
      },

      { "id": 17, "type": "row", "title": "IoT & Infrastruktur – InfluxDB (Flux)", "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 }, "collapsed": false },

      {
        "id": 18, "type": "timeseries", "title": "Container CPU-Nutzung (InfluxDB)",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "percent", "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 70, "color": "yellow" }, { "value": 90, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_cpu\")\n  |> filter(fn: (r) => r._field == \"usage_percent\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: r._value}))\n  |> yield(name: \"mean\")"
        }]
      },

      {
        "id": 19, "type": "timeseries", "title": "Container Memory-Nutzung (InfluxDB)",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 12, "y": 41, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "bytes", "color": { "mode": "palette-classic" } } },
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_mem\")\n  |> filter(fn: (r) => r._field == \"usage_bytes\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }]
      },

      {
        "id": 20, "type": "timeseries", "title": "Server-Temperaturen – Alle Sensoren (InfluxDB)",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "max": 110, "unit": "celsius", "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 65, "color": "yellow" }, { "value": 85, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"hwmon\")\n  |> filter(fn: (r) => r._field == \"temp_celsius\")\n  |> filter(fn: (r) => r.host =~ /node01/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }],
        "alert": {
          "name": "Kritische Server-Temperatur",
          "message": "Ein Temperatursensor auf $server überschreitet 85 °C für mehr als 2 Minuten.",
          "noDataState": "NoData", "executionErrorState": "Alerting", "frequency": "30s", "for": "2m", "handler": 1,
          "conditions": [{ "evaluator": { "params": [85], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["A", "2m", "now"] }, "reducer": { "params": [], "type": "max" }, "type": "query" }],
          "notifications": [{ "uid": "alert-channel-ops" }, { "uid": "alert-channel-pagerduty" }]
        }
      },

      {
        "id": 21, "type": "bargauge", "title": "Netzwerk-Pakete / Interface (InfluxDB)",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "pps",
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "blue" }, { "value": 10000, "color": "yellow" }, { "value": 50000, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"net\")\n  |> filter(fn: (r) => r._field == \"packets_recv\" or r._field == \"packets_sent\")\n  |> derivative(unit: 1s, nonNegative: true)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"pps\")"
        }]
      },

      {
        "id": 22, "type": "stat", "title": "InfluxDB – Write Throughput",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 0, "y": 57, "w": 8, "h": 4 },
        "fieldConfig": { "defaults": { "unit": "wps", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 5000, "color": "yellow" }, { "value": 10000, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "from(bucket: \"_monitoring\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"influxdb_write\")\n  |> filter(fn: (r) => r._field == \"pointsWrittenOK\")\n  |> last()\n  |> yield(name: \"last\")"
        }]
      },

      {
        "id": 23, "type": "stat", "title": "InfluxDB – Query Ausführungszeit (ms)",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 8, "y": 57, "w": 8, "h": 4 },
        "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 100, "color": "yellow" }, { "value": 500, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "from(bucket: \"_monitoring\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"qc_executed_buckets_total\")\n  |> filter(fn: (r) => r._field == \"dur\")\n  |> map(fn: (r) => ({r with _value: r._value / 1000000.0}))\n  |> mean()\n  |> yield(name: \"avg_ms\")"
        }]
      },

      {
        "id": 24, "type": "piechart", "title": "InfluxDB – Speichernutzung / Bucket",
        "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
        "gridPos": { "x": 16, "y": 57, "w": 8, "h": 4 },
        "fieldConfig": { "defaults": { "unit": "bytes" } },
        "options": { "pieType": "pie", "legend": { "displayMode": "table", "placement": "right" } },
        "targets": [{ "refId": "A", "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "queryType": "flux",
          "query": "buckets()\n  |> map(fn: (r) => ({bucket: r.name, sizeBytes: int(v: r.retentionPeriod)}))\n  |> group()\n  |> yield(name: \"buckets\")"
        }]
      },

      { "id": 25, "type": "row", "title": "Datenbank – MySQL", "gridPos": { "x": 0, "y": 61, "w": 24, "h": 1 }, "collapsed": false },

      {
        "id": 26, "type": "timeseries", "title": "Aktive DB-Verbindungen",
        "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
        "gridPos": { "x": 0, "y": 62, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 150, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(recorded_at, $interval) AS time,\n  AVG(value) AS \"Aktive Verbindungen\"\nFROM db_metrics\nWHERE $__timeFilter(recorded_at)\n  AND metric_name = 'threads_connected'\n  AND host = '$db_host'\nGROUP BY 1\nORDER BY 1"
        }],
        "alert": {
          "name": "Zu viele DB-Verbindungen",
          "message": "MySQL auf $db_host hat über 150 aktive Verbindungen für mehr als 5 Minuten.",
          "noDataState": "NoData", "executionErrorState": "Alerting", "frequency": "1m", "for": "5m", "handler": 1,
          "conditions": [{ "evaluator": { "params": [150], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["A", "5m", "now"] }, "reducer": { "params": [], "type": "avg" }, "type": "query" }],
          "notifications": [{ "uid": "alert-channel-dba" }]
        }
      },

      {
        "id": 27, "type": "timeseries", "title": "Slow Queries / Minute",
        "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
        "gridPos": { "x": 12, "y": 62, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 5, "color": "yellow" }, { "value": 20, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(start_time, $interval) AS time,\n  COUNT(*) AS \"Slow Queries\"\nFROM mysql.slow_log\nWHERE $__timeFilter(start_time)\n  AND query_time > 1\n  AND db = 'app_production'\nGROUP BY 1\nORDER BY 1"
        }],
        "alert": {
          "name": "Viele Slow Queries",
          "message": "Mehr als 20 Slow Queries pro Minute in app_production für mehr als 3 Minuten.",
          "noDataState": "NoData", "executionErrorState": "Alerting", "frequency": "1m", "for": "3m", "handler": 1,
          "conditions": [{ "evaluator": { "params": [20], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["A", "3m", "now"] }, "reducer": { "params": [], "type": "avg" }, "type": "query" }],
          "notifications": [{ "uid": "alert-channel-dba" }]
        }
      },

      {
        "id": 28, "type": "barchart", "title": "Top 10 – Größte Tabellen (MB)",
        "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
        "gridPos": { "x": 0, "y": 70, "w": 12, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "decmbytes" } },
        "targets": [{ "refId": "A", "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "format": "table",
          "rawSql": "SELECT\n  CONCAT(table_schema, '.', table_name) AS \"Tabelle\",\n  ROUND((data_length + index_length) / 1024 / 1024, 2) AS \"Größe (MB)\"\nFROM information_schema.tables\nWHERE table_schema NOT IN ('information_schema','performance_schema','mysql','sys')\nORDER BY (data_length + index_length) DESC\nLIMIT 10"
        }]
      },

      {
        "id": 29, "type": "bargauge", "title": "InnoDB Buffer Pool – Hit Rate %",
        "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
        "gridPos": { "x": 12, "y": 70, "w": 6, "h": 8 },
        "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "red" }, { "value": 90, "color": "yellow" }, { "value": 98, "color": "green" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "format": "table",
          "rawSql": "SELECT\n  'Buffer Pool Hit Rate' AS metric,\n  ROUND(\n    (1 - (SELECT variable_value FROM performance_schema.global_status WHERE variable_name = 'Innodb_buffer_pool_reads')\n      / NULLIF((SELECT variable_value FROM performance_schema.global_status WHERE variable_name = 'Innodb_buffer_pool_read_requests'), 0)\n    ) * 100, 2\n  ) AS value"
        }]
      },

      {
        "id": 30, "type": "stat", "title": "Replikations-Lag (s)",
        "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
        "gridPos": { "x": 18, "y": 70, "w": 6, "h": 4 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "s", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 5, "color": "yellow" }, { "value": 30, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(MAX(Seconds_Behind_Source), 0) AS \"Replikations-Lag (s)\"\nFROM performance_schema.replication_applier_status_by_worker"
        }],
        "alert": {
          "name": "Hoher Replikations-Lag",
          "message": "MySQL-Replikations-Lag auf $db_host übersteigt 30 Sekunden.",
          "noDataState": "Alerting", "executionErrorState": "Alerting", "frequency": "30s", "for": "1m", "handler": 1,
          "conditions": [{ "evaluator": { "params": [30], "type": "gt" }, "operator": { "type": "and" }, "query": { "params": ["A", "1m", "now"] }, "reducer": { "params": [], "type": "last" }, "type": "query" }],
          "notifications": [{ "uid": "alert-channel-dba" }, { "uid": "alert-channel-ops" }]
        }
      },

      {
        "id": 31, "type": "stat", "title": "Offene Transaktionen",
        "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
        "gridPos": { "x": 18, "y": 74, "w": 6, "h": 4 },
        "fieldConfig": { "defaults": { "min": 0, "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" }, { "value": 50, "color": "yellow" }, { "value": 200, "color": "red" }
          ]}
        }},
        "targets": [{ "refId": "A", "datasource": { "type": "mysql", "uid": "${DS_MYSQL}" },
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"Offene Transaktionen\"\nFROM information_schema.innodb_trx\nWHERE trx_state = 'RUNNING'"
        }]
      }

    ],

    "alerting": {
      "notification_channels": [
        { "uid": "alert-channel-ops",       "name": "Ops-Team (Slack)",    "type": "slack",
          "settings": { "url": "https://hooks.slack.com/services/DEMO/OPS/TOKEN", "recipient": "#alerts-ops", "username": "Grafana" } },
        { "uid": "alert-channel-dba",       "name": "DBA-Team (Slack)",    "type": "slack",
          "settings": { "url": "https://hooks.slack.com/services/DEMO/DBA/TOKEN", "recipient": "#alerts-dba", "username": "Grafana" } },
        { "uid": "alert-channel-pagerduty", "name": "PagerDuty Critical",  "type": "pagerduty",
          "settings": { "integrationKey": "DEMO_PAGERDUTY_KEY", "autoResolve": true, "severity": "critical" } }
      ]
    }
  }
}
