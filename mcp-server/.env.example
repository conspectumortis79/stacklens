# StackLens MCP Server
# All values can also be supplied per-request via the X-Stacklens-Config header
# (base64-encoded JSON), which always overrides values defined here.

# ── Server ──────────────────────────────────────────────────────────────────
MCP_PORT=7456
MCP_HOST=0.0.0.0
# Optional shared bearer token. Clients must send it as Authorization: Bearer <token>.
MCP_AUTH_TOKEN=

# ── Jira ────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_CLOUD_MODE=true

# ── Confluence ──────────────────────────────────────────────────────────────
CONFLUENCE_BASE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_MODE=true

# ── GitLab ──────────────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.com
GITLAB_ACCESS_TOKEN=

# ── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_API_KEY=
